<Window x:Class="_3._1obliczkwadrat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3._1obliczkwadrat"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Bok" HorizontalAlignment="Left" Margin="122,70,0,0" VerticalAlignment="Top" x:Name="lblBok"/>
        <Label Content="Pole" HorizontalAlignment="Left" Margin="119,133,0,0" VerticalAlignment="Top" x:Name="lblPole"/>
        <Label Content="Obwod" HorizontalAlignment="Left" Margin="113,191,0,0" VerticalAlignment="Top" x:Name="lblObwod"/>
        
        <TextBox HorizontalAlignment="Left" Margin="326,79,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtBok" TextChanged="txtBok_TextChanged_1"/>
        <TextBox HorizontalAlignment="Left" Margin="326,141,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtPole" IsEnabled="False"/>
        <TextBox HorizontalAlignment="Left" Margin="326,204,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtObwod" IsEnabled="False"/>
        <Label Content="Wpisz wymiar boku" HorizontalAlignment="Left" Margin="508,75,0,0" VerticalAlignment="Top" x:Name="lblKomunikat" Foreground="Red"/>
        <Button Content="Wyczyść" HorizontalAlignment="Left" Margin="366,311,0,0" VerticalAlignment="Top" x:Name ="btnWyczysc" Click="btnWyczysc_Click_1"/>

    </Grid>
</Window>
