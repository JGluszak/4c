<Window x:Class="_3._1obliczkwadrat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3._1obliczkwadrat"
        mc:Ignorable="d"
        Title="Rysowanie kwadratu" Height="500" Width="700">
    <Grid>
        <Label Content="Bok" HorizontalAlignment="Left" Margin="90,50,0,0" VerticalAlignment="Top" x:Name="lblBok"/>
        <Label Content="Pole" HorizontalAlignment="Left" Margin="90,120,0,0" VerticalAlignment="Top" x:Name="lblPole"/>
        <Label Content="Obwod" HorizontalAlignment="Left" Margin="90,190,0,0" VerticalAlignment="Top" x:Name="lblObwod"/>
        <Label Content="Kolor" HorizontalAlignment="Left" Margin="90,260,0,0" VerticalAlignment="Top"/>


        <TextBox HorizontalAlignment="Left" Margin="200,50,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtBok" TextChanged="txtBok_TextChanged_1"/>
        <TextBox HorizontalAlignment="Left" Margin="200,120,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtPole" IsEnabled="False"/>
        <TextBox HorizontalAlignment="Left" Margin="200,190,0,0"  TextWrapping="Wrap" VerticalAlignment="Top" Width="120" x:Name="txtObwod" IsEnabled="False"/>
        <Label Content="Wpisz wymiar boku" HorizontalAlignment="Left" Margin="199,0,0,0" VerticalAlignment="Top" x:Name="lblKomunikat" Foreground="Red"/>
        <Button Content="Wyczyść" HorizontalAlignment="Left" Margin="236,424,0,0" VerticalAlignment="Top" x:Name ="btnWyczysc" Click="btnWyczysc_Click_1"/>
        <ComboBox x:Name="cmbKolory" HorizontalAlignment="Left" Margin="200,262,0,0" VerticalAlignment="Top" Width="120"  SelectedIndex="0">
            <ComboBoxItem>Black</ComboBoxItem>
            <ComboBoxItem>Red</ComboBoxItem>
            <ComboBoxItem>Yellow</ComboBoxItem>
            <ComboBoxItem>Green</ComboBoxItem>
            <ComboBoxItem>Blue</ComboBoxItem>
        </ComboBox>
        <CheckBox x:Name="cbPrzezroczysty" Content="Półprzeźroczysty" HorizontalAlignment="Left" Margin="200,323,0,0" VerticalAlignment="Top" Width="120"/>
        <Rectangle x:Name="rectangle1" HorizontalAlignment="Left" Height="0" Width="0" Margin="336,42,0,0" Stroke="Black" VerticalAlignment="Top" />
        <Button Content="Rysuj" HorizontalAlignment="Left" Margin="240,370,0,0" VerticalAlignment="Top" Click="btnRysuj"/>

    </Grid>
</Window>
