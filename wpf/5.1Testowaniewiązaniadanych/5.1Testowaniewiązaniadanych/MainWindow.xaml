<Window x:Class="_5._1Testowaniewiązaniadanych.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_5._1Testowaniewiązaniadanych"
        mc:Ignorable="d"
        Title="MainWindow" Height="200" Width="500">
    <StackPanel>
        <Slider x:Name="rozmiar" Minimum="10" Maximum="45" Value="15"/>
        <TextBlock FontSize="{Binding Path=Value, ElementName=rozmiar}" Text="Testujemy wiązanie danych"/>
    </StackPanel>
</Window>
